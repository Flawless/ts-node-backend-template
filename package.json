{
  "name": "node-backend-template",
  "version": "1.0.0",
  "description": "Production-grade Node.js backend/frontend template with extreme strictness, Testing Trophy philosophy, and comprehensive observability",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:debug": "tsx watch --inspect --clear-screen=false src/index.ts",
    "build": "npm run build:guard && tsc && tsc-alias",
    "build:guard": "tsx scripts/build-guard.ts",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "rm -rf dist coverage .turbo .vitest-reports",
    "prepare": "husky",
    "pre-commit": "npm run type-check && npm run lint && npm run format:check && npm run test:coverage",
    "security:audit": "npm audit --audit-level=low",
    "security:licenses": "license-checker --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;Python-2.0;MPL-2.0;CC0-1.0;CC-BY-3.0;0BSD' --excludePrivatePackages",
    "security:secrets": "truffleHog filesystem . --no-update --fail",
    "quality:duplication": "jscpd src/ --threshold 3 --reporters console --format \"typescript|javascript\"",
    "quality:complexity": "madge --circular --extensions ts,tsx,js,jsx src/",
    "quality:dependencies": "depcheck",
    "validate:all": "npm run security:audit && npm run security:licenses && npm run quality:duplication && npm run quality:complexity",
    "docker:build": "docker build -t node-backend-template .",
    "docker:build:prod": "docker build -f Dockerfile.prod -t node-backend-template:prod .",
    "docker:run": "docker run -p 3000:3000 --env-file .env node-backend-template",
    "generate:types": "tsx scripts/generate-types.ts",
    "telemetry:test": "tsx scripts/test-telemetry.ts",
    "setup:validate": "tsx scripts/validate-setup.ts",
    "postinstall": "npm run setup:validate"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/compress": "^8.0.1",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@sinclair/typebox": "^0.34.11",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.54.2",
    "@opentelemetry/exporter-prometheus": "^0.54.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.2",
    "@opentelemetry/instrumentation": "^0.54.2",
    "@opentelemetry/instrumentation-fastify": "^0.42.0",
    "@opentelemetry/instrumentation-http": "^0.54.2",
    "@opentelemetry/instrumentation-pino": "^0.43.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-metrics": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.54.2",
    "@opentelemetry/sdk-trace-base": "^1.28.0",
    "@opentelemetry/sdk-trace-node": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "close-with-grace": "^2.1.0",
    "env-schema": "^6.0.0",
    "fluent-json-schema": "^5.0.0",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "depcheck": "^1.4.7",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.15.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^2.0.4",
    "eslint-plugin-unicorn": "^56.0.1",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "license-checker": "^25.0.1",
    "lint-staged": "^15.2.11",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "semgrep": "^1.87.0",
    "tsx": "^4.19.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "chalk": "^5.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/example/node-backend-template.git"
  },
  "keywords": [
    "nodejs",
    "fastify",
    "backend",
    "frontend",
    "template",
    "typescript",
    "testing-trophy",
    "clean-architecture",
    "production-ready",
    "opentelemetry",
    "observability",
    "extreme-strictness"
  ],
  "author": "",
  "license": "MIT"
}